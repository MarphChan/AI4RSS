image:
  enable_generation: false
  provider: wanx
  default_images:
    - static/images/ai_news.svg
llm:
  # Provider options: dashscope, volcengine, deepseek, moonshot, yi, anthropic, custom
  provider: dashscope
  api_key: "YOUR_API_KEY_HERE"
  # base_url: only needed for custom provider or when different from defaults
  # base_url: https://dashscope.aliyuncs.com/compatible-mode/v1
  # Model examples:
  #   - dashscope: qwen-plus-2025-12-01, qwen-max
  #   - volcengine: doubao-pro-32k
  #   - deepseek: deepseek-chat
  #   - moonshot: moonshot-v1-8k
  #   - anthropic: claude-3-5-sonnet-20241022, claude-3-opus-20240229
  model_name: qwen-plus-2025-12-01
notification:
  webhook_url: "YOUR_WEBHOOK_URL_HERE"
system:
  fetch_time: "08:00"
  max_items: 20
  push_time: "09:30"
  time_period: 168
  timezone: Asia/Shanghai
feishu:
  receiver_enabled: false
  receiver_host: "127.0.0.1"
  receiver_port: 8765
  receiver_token: ""
